{
  "manifest_version": 3,
  "name": "VLC Bridge for Silo",
  "version": "0.2.8",
  "description": "Open original Silo video streams in VLC on Windows.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Configure VLC Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [],
  "key": ""
}
